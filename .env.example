# Copia este archivo como .env antes de levantar los servicios.
POSTGRES_DB=lagoassist
POSTGRES_USER=lagoassist
POSTGRES_PASSWORD=cambia-esta-contrasena

# Puerto público del frontend. La API se sirve internamente en /api.
WEB_PORT=80

# Habilítalo solo para una base nueva de desarrollo.
APP_SEED_ENABLED=false
