# Copia este archivo como .env antes de levantar los servicios.
POSTGRES_DB=lagoassist
POSTGRES_USER=lagoassist
POSTGRES_PASSWORD=cambia-esta-contrasena

# Base de datos de producción (Supabase / PostgreSQL).
# Usa el SESSION POOLER o la conexión DIRECTA (puerto 5432), NUNCA el
# transaction pooler (puerto 6543): con 6543 falla con "prepared statement does not exist".
# Formato para Supabase (llena <region> y <ref> con los datos de tu proyecto):
#   DATABASE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   DATABASE_USERNAME=postgres
#   DATABASE_PASSWORD=tu-contraseña

# Puerto público del frontend. La API se sirve internamente en /api.
WEB_PORT=80

# Habilítalo solo para una base nueva de desarrollo.
APP_SEED_ENABLED=false
